# Chat Completions-compatible endpoint. Never commit your real .env.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
# 1 = strict JSON Schema; 0 = prompt-only JSON. Enable only if supported.
LLM_JSON_MODE=1
# Ark supports disabling internal thinking. Omit for other providers.
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
